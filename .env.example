# Bot tokeni: Discord Developer Portal > Bot > Reset Token
DISCORD_TOKEN=

# Komut oneki, ornek: !play
PREFIX=!

# ffmpeg yolu. Bos birakilirsa otomatik bulunur.
FFMPEG_PATH=

# YouTube davranislari
# PLAYER_CLIENTS bos ise yt-dlp varsayilanini kullanir.
# Ornek: android,web_safari,ios
PLAYER_CLIENTS=
# YouTube cookies.txt dosyasinin yolu (yas/ozel videolar icin)
COOKIES_FILE=
# Sunucularda (Render vb.) YouTube bot dogrulamasini asmak icin cookies.txt icerigini
# base64 olarak buraya koy; acilista COOKIES_FILE'a yazilir:
# YOUTUBE_COOKIES_B64=
PROXY=
STREAM_FORMAT=bestaudio/best
FALLBACK_FORMAT=worstaudio/worst
DOWNLOAD_FORMAT=bestaudio/best

# Kuyruk / arama
MAX_PLAYLIST_ITEMS=50
MAX_SEARCH_RESULTS=5
SEARCH_TTL_SECONDS=180

# Sure kisitlari
MAX_DURATION_MINUTES=180
MIN_DURATION_SECONDS=30
ALLOW_SHORT=false
ALLOW_LIVE=true

# Ses
VOLUME_DEFAULT=0.45
VOLUME_MAX=2.0
NORMALIZE_AUDIO=false
AUDIO_FILTER=

# Davranis
LOOP_DEFAULT=false
IDLE_TIMEOUT_SECONDS=900